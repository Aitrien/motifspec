{
  "name": "@aitrien/motifspec",
  "version": "1.10.3",
  "private": true,
  "description": "Liam Marshall's design system: DTCG tokens, component rules and generated CSS.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aitrien/motifspec.git"
  },
