{
  "name": "@aitrien/motifspec",
  "version": "1.14.1",
  "description": "Liam Marshall's design system: DTCG tokens, component rules, generated CSS, Hugo templates and a rule checker.",
  "keywords": [
    "design-system",
    "design-tokens",
    "dtcg",
    "css",
    "hugo"
  ],
  "homepage": "https://github.com/Aitrien/motifspec#readme",
  "bugs": "https://github.com/Aitrien/motifspec/issues",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aitrien/motifspec.git"
  },
  "changelog": "https://github.com/Aitrien/motifspec/blob/main/CHANGELOG.md",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/showcase.html",
    "!dist/showcase.standalone.html",
    "tokens",
    "docs",
    "fonts",
    "icons",
    "layouts",
    "scripts/check.mjs",
    "scripts/lib.mjs",
    "CHANGELOG.md"
  ],
  "bin": {
    "motifspec-check": "scripts/check.mjs"
  },
  "exports": {
    "./codex.css": "./dist/codex.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./chroma.css": "./dist/chroma.css",
    "./codex.js": "./dist/codex.js",
    "./theme-init.js": "./dist/theme-init.js",
    "./plate.js": "./dist/plate.js",
    "./plate.html": "./dist/plate.html",
    "./backdrop.html": "./dist/backdrop.html",
    "./icons.svg": "./dist/icons.svg",
    "./tokens.js": "./dist/tokens.js",
    "./tokens.json": "./dist/tokens.json",
    "./check": "./scripts/check.mjs",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/validate.mjs && node scripts/build.mjs",
    "audit": "node scripts/audit.mjs",
    "check": "node scripts/check.mjs",
    "release:check": "node scripts/release.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "test:mcp": "node --test mcp/test.mjs",
    "mcp:bundle": "node mcp/build.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "esbuild": "0.28.2",
    "zod": "4.6.7"
  }
}
