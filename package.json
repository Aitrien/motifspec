    "./codex.js": "./dist/codex.js",
    "./theme-init.js": "./dist/theme-init.js",
    "./tokens.js": "./dist/tokens.js",
    "./tokens.json": "./dist/tokens.json",
    "./plate.js": "./dist/plate.js",
    "./plate.html": "./dist/plate.html",
    "./backdrop.html": "./dist/backdrop.html",
    "./package.json": "./package.json"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/validate.mjs && node scripts/build.mjs",
    "audit": "node scripts/audit.mjs"
  },
  "engines": {
    "node": ">=20"
  }
