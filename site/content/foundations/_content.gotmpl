{{- /* Foundations pages, from the README. */ -}}
{{- $readme := (resources.Get "src/README.md").Content -}}
{{- $.AddPage (partial "src/page.html" (dict "path" "principles" "title" "Principles" "lede" "Seven rules every token, component and layout follows." "body" (partial "src/section.html" (dict "text" $readme "heading" "Principles")) "source" "README.md" "section" "Principles" "weight" 1)) -}}
{{- $.AddPage (partial "src/page.html" (dict "path" "identity" "title" "The identity in brief" "lede" "The concept behind MotifSpec's look, and what carries it." "body" (partial "src/section.html" (dict "text" $readme "heading" "The identity in brief")) "source" "README.md" "section" "The identity in brief" "weight" 2)) -}}
{{- /* Pages generated from MotifSpec's own data by scripts/docs-reference.mjs (npm run docs writes them first). */ -}}
{{- range resources.Match "generated/foundations/*.md" -}}
  {{- $d := partial "src/doc.html" .Content -}}
  {{- $.AddPage (partial "src/page.html" (dict "path" (path.BaseName .Name) "title" $d.title "lede" $d.lede "body" $d.body "source" $d.front.source "weight" $d.front.weight "params" (dict "toc" $d.front.toc "data" $d.front.data))) -}}
{{- end -}}
