{{- /* Guide pages, from the README's sections and CONVENTIONS.md. */ -}}
{{- $readme := (resources.Get "src/README.md").Content -}}
{{- $conv := (resources.Get "src/CONVENTIONS.md").Content -}}
{{- $pages := slice
    (dict "path" "getting-started" "title" "Getting started" "heading" "Getting started" "file" "README.md" "text" $readme)
    (dict "path" "choosing-a-layout" "title" "Choosing a layout" "heading" "Layouts" "file" "README.md" "text" $readme)
    (dict "path" "rules" "title" "Rules for AI assistants" "heading" "Rules for AI assistants" "file" "README.md" "text" $readme "lede" "What an assistant building with MotifSpec must follow. The MCP server's get_rules returns the same list.")
    (dict "path" "checking" "title" "Checking a project" "heading" "Checking a project" "file" "README.md" "text" $readme)
    (dict "path" "releasing" "title" "Releasing and versions" "heading" "Versioning (semver)" "file" "CONVENTIONS.md" "text" $conv "lede" "What each kind of change does to the version, and how a merge becomes a release.")
-}}
{{- range $i, $p := $pages -}}
  {{- $body := partial "src/section.html" (dict "text" $p.text "heading" $p.heading) -}}
  {{- $lede := $p.lede -}}
  {{- if not $lede }}{{ $d := partial "src/doc.html" $body }}{{ $lede = $d.lede }}{{ $body = $d.body }}{{ end -}}
  {{- $.AddPage (partial "src/page.html" (dict "path" $p.path "title" $p.title "lede" $lede "body" $body "source" $p.file "section" $p.heading "weight" (add $i 1))) -}}
{{- end -}}
