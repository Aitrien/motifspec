    "size": {
      "$type": "dimension",
      "display": {
        "$value": "{primitive.font.size.8}",
        "$description": "The single largest line on a page (home statement). Once per page at most."
      },
      "heading-1": {
        "$value": "{primitive.font.size.7}",
        "$description": "Page titles: h1 on posts, projects and indexes."
      },
      "heading-2": {
        "$value": "{primitive.font.size.6}",
        "$description": "Section headings (h2) in prose and on index pages."
      },
      "heading-3": {
        "$value": "{primitive.font.size.5}",
        "$description": "Sub-section headings (h3) and card titles in featured layouts."
      },
      "heading-4": {
        "$value": "{primitive.font.size.4}",
        "$description": "Minor headings (h4) and standard card titles."
      },
      "lede": {
        "$value": "{primitive.font.size.4}",
        "$description": "The introductory paragraph under a page title. One per page."
      },
      "body": {
        "$value": "{primitive.font.size.3}",
        "$description": "Running text and default UI text."
      },
      "small": {
        "$value": "{primitive.font.size.2}",
        "$description": "Captions, metadata, table cells, code blocks, button labels."
      },
      "label": {
        "$value": "{primitive.font.size.1}",
        "$description": "Mono uppercase labels: accession fields, eyebrows, tags, table headers. Always with font.tracking.label."
      },
      "code-inline": {
        "$type": "number",
        "$value": "{primitive.font.relative.code}",
        "$extensions": {
          "codex.unit": "em"
        },
        "$description": "Inline code relative to surrounding text, so mono matches the x-height of National Park."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "body": {
        "$value": "{primitive.font.weight.regular}",
        "$description": "Running text."
      },
      "ui": {
        "$value": "{primitive.font.weight.medium}",
        "$description": "Nav items, labels and mono metadata."
      },
      "strong": {
        "$value": "{primitive.font.weight.semibold}",
        "$description": "<strong>, button labels and table header text. National Park has no italic, so <em> uses a synthetic oblique; use strong for real emphasis."
      },
      "heading": {
        "$value": "{primitive.font.weight.semibold}",
        "$description": "h2-h4 and card titles."
      },
      "display": {
        "$value": "{primitive.font.weight.bold}",
        "$description": "h1 and the display statement only."
      }
    },
    "line-height": {
      "$type": "number",
      "display": {
        "$value": "{primitive.font.line-height.tight}",
        "$description": "Display and h1, set with tight tracking."
      },
      "heading": {
        "$value": "{primitive.font.line-height.snug}",
        "$description": "h2-h4 and card titles."
      },
      "ui": {
        "$value": "{primitive.font.line-height.normal}",
        "$description": "Single-line UI: nav, buttons, labels, table cells."
      },
      "body": {
        "$value": "{primitive.font.line-height.relaxed}",
        "$description": "Running text at the prose measure."
      },
      "code": {
        "$value": "{primitive.font.line-height.relaxed}",
        "$description": "Code blocks."
      }
    },
    "tracking": {
      "$type": "number",
      "display": {
        "$value": "{primitive.font.tracking.tighter}",
        "$description": "Display and h1 sizes."
      },
      "heading": {
        "$value": "{primitive.font.tracking.tight}",
        "$description": "h2-h4 headings and card titles."
      },
      "body": {
        "$value": "{primitive.font.tracking.none}",
        "$description": "Running text. Never track lowercase body text."
      },
      "label": {
        "$value": "{primitive.font.tracking.wider}",
        "$description": "Mono uppercase labels."
      },
      "ui": {
        "$value": "{primitive.font.tracking.wide}",
        "$description": "Mono lowercase tags and small UI text."
      }
    }
  }
}
