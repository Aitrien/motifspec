  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": "{primitive.font.family.national-park}",
        "$description": "Headings, the wordmark and the home statement."
      },
      "body": {
        "$value": "{primitive.font.family.national-park}",
        "$description": "Running text, UI text, nav and buttons. The default family on body."
      },
      "mono": {
        "$value": "{primitive.font.family.geist-mono}",
        "$description": "Code, plus short machine-like labels: accession numbers, dates, tags, eyebrow labels, table headers. Never for paragraphs."
      },
      "ornament": {
        "$value": "{primitive.font.family.yarndings-12}",
