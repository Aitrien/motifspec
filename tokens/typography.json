      "relative": {
        "$type": "number",
        "code": {
          "$value": 0.875,
          "$description": "Size of inline code relative to its parent text (em). Primitive.",
          "$extensions": {
            "codex.tier": "primitive",
            "codex.unit": "em"
          }
        }
      },
      "tracking": {
        "$type": "number",
        "$description": "Letter-spacing in em (see codex.unit). Primitive.",
