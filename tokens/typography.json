            "ui-sans-serif",
            "system-ui",
            "-apple-system",
            "Segoe UI",
            "Roboto",
            "sans-serif"
          ],
          "$description": "National Park (OFL), variable wght 200-800, Latin subset 38 KB. Primitive.",
          "$extensions": {
            "codex.tier": "primitive"
          }
        },
        "geist-mono": {
          "$value": [
            "Geist Mono",
