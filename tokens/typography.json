          "$value": -0.025,
          "$extensions": {
            "codex.tier": "primitive",
            "codex.unit": "em"
          }
        },
        "tight": {
          "$value": -0.015,
          "$extensions": {
            "codex.tier": "primitive",
            "codex.unit": "em"
          }
